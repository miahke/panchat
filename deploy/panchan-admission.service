[Unit]
Description=Panchan local device admission owner service
After=local-fs.target

[Service]
Type=simple
User=panchan-admission
Group=panchan-admission
ExecStart=/opt/panchan/admission/current/panchan-admission serve
StateDirectory=panchan-admission
StateDirectoryMode=0700
RuntimeDirectory=panchan-admission
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
LimitNOFILE=128
TasksMax=32
MemoryMax=128M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
